---
import StationSearch from './StationSearch.astro';

// The live board for one station. Renders the shell server-side (station name,
// tabs, board scaffolding); the client (board-client.ts) fetches live data and
// drives refresh + aria-live announcements.
interface Props {
  crs: string;
  stationName: string;
}
const { crs, stationName } = Astro.props;

// `||` (not ??) so an empty/unset var falls back to the live Worker.
const apiBase = import.meta.env.PUBLIC_API || 'https://trains-api.upyesp.workers.dev';
const mock = import.meta.env.PUBLIC_MOCK === 'true';
---

<section class="station-head">
  <h1 class="station" id="station-name">{stationName} ({crs})</h1>
  <p class="station-crs">National Rail</p>

  <div class="station-meta">
    <span class="live"><span class="dot" aria-hidden="true"></span> Live</span>
    <span class="clock" id="clock" aria-label="Current time">--:--:--</span>
  </div>

  <StationSearch />
</section>

<div class="tabs" role="tablist" aria-label="Board type" id="tablist">
  <button
    role="tab"
    id="tab-dep"
    data-kind="departures"
    aria-selected="true"
    aria-controls="board"
    tabindex="0">Departures</button
  >
  <button
    role="tab"
    id="tab-arr"
    data-kind="arrivals"
    aria-selected="false"
    aria-controls="board"
    tabindex="-1">Arrivals</button
  >
</div>

<div class="board-filters">
  <div class="combo combo-filter" id="combo-filter">
    <label for="calls-input">Calling at</label>
    <span class="combo-field">
      <input
        id="calls-input"
        type="text"
        role="combobox"
        aria-expanded="false"
        aria-haspopup="listbox"
        aria-controls="calls-list"
        aria-autocomplete="list"
        placeholder="Any station (filter)"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
      />
      <button type="button" class="combo-clear" aria-label="Clear calling-at filter" hidden> ✕ </button>
      <ul id="calls-list" class="combo-list" role="listbox" aria-label="Calling at station" hidden></ul>
    </span>
  </div>
</div>

<section
  id="board"
  class="board-panel"
  role="tabpanel"
  aria-labelledby="tab-dep"
  tabindex="-1"
  data-crs={crs}
  data-kind="departures"
  data-api={apiBase}
  data-mock={mock ? 'true' : 'false'}
>
  <p class="as-of">
    <span id="as-of">As of --:--</span>
    <span class="stale" id="stale-note" role="status"></span>
  </p>
  <div class="board-cols" aria-hidden="true">
    <span class="col-time">Time</span>
    <span class="col-dest">Destination</span>
    <span class="col-plat">Platform</span>
    <span class="col-status">Status</span>
  </div>
  <ol class="board" id="board-body" aria-label={`Live departures from ${stationName}`}>
    <li class="board-msg">This live board needs JavaScript — enable it to see today’s services.</li>
  </ol>
</section>

<!-- Visually hidden live region: meaningful changes only (ADR-0002) -->
<div
  id="announcer"
  class="visually-hidden"
  role="status"
  aria-live="polite"
  aria-atomic="true"
></div>

<script>
  import { initBoard } from '../scripts/board-client';
  const root = document.getElementById('board');
  if (root instanceof HTMLElement) initBoard(root);
</script>
