---
import StationSearch from './StationSearch.astro';

// The live board for one station. Renders the shell server-side (station name,
// tabs, board scaffolding); the client (board-client.ts) fetches live data and
// drives refresh + aria-live announcements.
interface Props {
  crs: string;
  stationName: string;
}
const { crs, stationName } = Astro.props;

// `||` (not ??) so an empty/unset var falls back to the live Worker.
const apiBase = import.meta.env.PUBLIC_API || 'https://trains-api.upyesp.workers.dev';
const mock = import.meta.env.PUBLIC_MOCK === 'true';
---

<section class="station-head">
  <h1 class="station" id="station-name">{stationName}</h1>
  <p class="station-crs"><code>{crs}</code> · National Rail</p>

  <div class="station-meta">
    <span class="live"><span class="dot" aria-hidden="true"></span> Live</span>
    <span class="clock" id="clock" aria-label="Current time">--:--:--</span>
  </div>

  <StationSearch />
</section>

<div class="tabs" role="tablist" aria-label="Board type" id="tablist">
  <button
    role="tab"
    id="tab-dep"
    data-kind="departures"
    aria-selected="true"
    aria-controls="board"
    tabindex="0">Departures</button
  >
  <button
    role="tab"
    id="tab-arr"
    data-kind="arrivals"
    aria-selected="false"
    aria-controls="board"
    tabindex="-1">Arrivals</button
  >
</div>

<section
  id="board"
  class="board-panel"
  role="tabpanel"
  aria-labelledby="tab-dep"
  tabindex="-1"
  data-crs={crs}
  data-kind="departures"
  data-api={apiBase}
  data-mock={mock ? 'true' : 'false'}
>
  <p class="as-of">
    <span id="as-of">As of --:--</span>
    <span class="stale" id="stale-note" role="status"></span>
  </p>
  <table class="board">
    <caption class="visually-hidden">
      Live train departures from <span id="caption-station">{stationName} departures</span>
    </caption>
    <thead>
      <tr>
        <th scope="col">Time</th>
        <th scope="col">Destination</th>
        <th scope="col">Platform</th>
        <th scope="col">Status</th>
      </tr>
    </thead>
    <tbody id="board-body">
      <tr><td colspan="4" class="board-msg">Loading live board…</td></tr>
    </tbody>
  </table>
</section>

<!-- Visually hidden live region: meaningful changes only (ADR-0002) -->
<div
  id="announcer"
  class="visually-hidden"
  role="status"
  aria-live="polite"
  aria-atomic="true"
></div>

<script>
  import { initBoard } from '../scripts/board-client';
  const root = document.getElementById('board');
  if (root instanceof HTMLElement) initBoard(root);
</script>
