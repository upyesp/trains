---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Cap text inflation at the author's sizes in EVERY browser. Firefox,
         Chrome and Safari each run their own inflation algorithm, which made
         text larger in Firefox than Chrome; `100%` keeps every browser at the
         sizes we set (it does NOT block the user's own font-size setting).
         Inline so the build's CSS transformer can't strip the -webkit-/-moz-
         prefixes that Chrome/Safari and older Firefox need. -->
    <style is:inline>html{-webkit-text-size-adjust:100%;-moz-text-size-adjust:100%;text-size-adjust:100%}</style>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <meta name="theme-color" id="theme-color" content="#0f141b" />
    <!-- Apply the saved theme BEFORE first paint: try the user's stored
         preference, else follow the device's system theme, falling back to
         dark. Works as dark even with JS disabled (:root defaults are dark). -->
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) { /* no-op */ }

        if (t !== 'light' && t !== 'dark') {
          // No saved preference — follow the device's system theme.
          try {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
          } catch (e) { t = 'dark'; }
        }

        var h = document.documentElement;
        h.setAttribute('data-theme', t);
        h.style.colorScheme = t;
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', t === 'dark' ? '#0f141b' : '#f6f7f9');
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <header class="site">
        <div class="brand-wrap">
          <a class="brand" href="/"><svg
            class="brand-logo"
            viewBox="0 0 64 64"
            aria-hidden="true"
            focusable="false"
          ><rect width="64" height="64" rx="14" fill="#f0b429"/><g transform="translate(-5.85 6.38) scale(0.048788)"><path fill="#071f4d" d="M387 111L387 582C387 588.22 387.607 594.74 386 600.73C377.273 577.64 366.787 555.17 357.309 532.42C335.9 481.05 314.67 429.58 293.309 378.18C282.938 353.22 272.702 328.2 262.309 303.26C257.632 292.03 254.17 277.54 247 268L247 425.55L247 474.03C247 481.65 245.736 490.89 247.637 498.27C250.075 507.73 255.766 517.03 259.753 525.81L282.753 576.49C307.463 630.94 332.54 685.11 357.247 739.55L376.247 781.42C379.604 788.82 384.309 796.58 386.363 804.56C388.426 812.57 387 822.72 387 831L387 839L387 994L470 994L470 831C470 822.72 468.574 812.57 470.637 804.56C472.691 796.58 477.396 788.82 480.753 781.42L499.753 739.55C524.46 685.11 549.537 630.94 574.247 576.49L597.247 525.81C601.234 517.03 606.925 507.73 609.363 498.27C611.264 490.89 610 481.65 610 474.03L610 425.55L610 268C602.83 277.54 599.368 292.03 594.691 303.26C584.298 328.2 574.062 353.22 563.691 378.18C542.33 429.58 521.1 481.05 499.691 532.42C490.213 555.17 479.727 577.64 471 600.73C469.393 594.74 470 588.22 470 582L470 548.95L470 440.98L470 111L387 111zM721 268L721 831L804 831L804 268L721 268zM915 268L915 831L998 831L998 643L1185.5 643C1289.05 643 1373 559.05 1373 455.5C1373 351.95 1289.05 268 1185.5 268L998 268L915 268z"/><path fill="#f0b429" d="M998 351L1185.5 351C1243.21 351 1290 397.79 1290 455.5C1290 513.21 1243.21 560 1185.5 560L998 560L998 351z"/></g></svg>VIPTrains.org.uk</a>
          <span class="brand-tag">UK mainline, live</span>
        </div>
        <div class="menu-wrap">
          <button
            class="menu-btn"
            id="menu-btn"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="menu-panel"
            aria-label="Open menu"
          >
            <span class="bar" aria-hidden="true"></span>
            <span class="bar" aria-hidden="true"></span>
            <span class="bar" aria-hidden="true"></span>
          </button>
          <div id="menu-panel" class="menu-panel" role="region" aria-label="Site menu" hidden>
            <div class="menu-section">
              <p class="menu-label" id="theme-label">Colour theme</p>
              <div class="seg" role="group" aria-labelledby="theme-label">
                <button class="seg-btn" type="button" data-theme-set="light" aria-pressed="false">
                  <span class="seg-ico" aria-hidden="true">&#9728;</span> Light
                </button>
                <button class="seg-btn" type="button" data-theme-set="dark" aria-pressed="false">
                  <span class="seg-ico" aria-hidden="true">&#9790;</span> Dark
                </button>
              </div>
            </div>
            <nav class="menu-section" aria-label="Site">
              <a class="menu-link" href="/">Home</a>
              <a class="menu-link" href="/history">History</a>
              <a class="menu-link" href="/about">About</a>
              <a class="menu-link" href="/contact">Contact</a>
              <a class="menu-link" href="/privacy">Privacy</a>
            </nav>
          </div>
        </div>
      </header>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer class="site">
        <p>
          Live data from Realtime Trains, via a caching proxy. Times are advisory;
          always check station information displays.
        </p>
      </footer>
    </div>
    <script>
      import { initMenu } from '../scripts/menu';
      initMenu(document.body);
    </script>
    <!-- No longer a PWA: unregister any service worker a previous install left
         behind and drop its caches, so the site behaves as a plain website. -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(function (rs) {
          rs.forEach(function (r) { r.unregister(); });
        });
      }
      if (window.caches) {
        caches.keys().then(function (keys) {
          keys.forEach(function (k) { caches.delete(k); });
        });
      }
    </script>
  </body>
</html>
