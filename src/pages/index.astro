---
import BaseLayout from '../layouts/BaseLayout.astro';
import StationSearch from '../components/StationSearch.astro';
---

<BaseLayout
  title="VIP Trains — UK mainline live departure boards"
  description="Live departure and arrival boards for UK mainline railway stations, updated every 30 seconds."
>
  <section class="home">
    <h1 class="home-title">Find a station</h1>
    <p class="home-lede">
      Live UK mainline departure and arrival boards, updated every 30 seconds. This site is optimised for VIPs (visually impaired people).
    </p>

    <StationSearch label="Search stations" />
  </section>
</BaseLayout>
