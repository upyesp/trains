---
import BaseLayout from '../layouts/BaseLayout.astro';
import StationSearch from '../components/StationSearch.astro';
---

<BaseLayout
  title="VIPTrains.org — UK mainline live departure boards"
  description="Live departure and arrival boards for UK mainline railway stations, updated every 30 seconds."
>
  <section class="home">
    <h1 class="home-title">Find a station</h1>
    <p class="home-lede">
      A not for profit site with the aim of providing UK train departure board
      information in a format optimised for vision impaired people (VIPs).
    </p>
    <p class="home-lede">
      The site is frequently updated, thanks to feedback received from users.
    </p>
    <p class="home-lede">
      If you find an issue or have suggestions for improving the site, please
      get in touch, using the contact form <a href="/contact">here</a>.
    </p>

    <StationSearch label="Search stations" />
  </section>
</BaseLayout>
