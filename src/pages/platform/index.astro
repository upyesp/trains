---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Per-platform board page. Static SSG shell; the client (platform-client.ts)
// reads ?station=<CRS>&platform=<number> from the URL (so the page is
// shareable and survives "add to home screen"), fetches both directions of
// the station's board from the Worker with a one-hour lookback, and lists the
// services that use this platform. Reached by clicking a platform number on
// the station board or the calling-points list.
//
// `||` (not ??) so an empty/unset var falls back to the live Worker.
const apiBase = import.meta.env.PUBLIC_API || 'https://trains-api.upyesp.workers.dev';
const mock = import.meta.env.PUBLIC_MOCK === 'true';
---

<BaseLayout
  title="Platform — VIPTrains.org"
  description="All departures and arrivals from one platform at a UK mainline station."
>
  <p id="plat-back" class="back-wrap"></p>

  <section class="station-head">
    <h1 class="page-title" id="plat-title">Platform</h1>
    <p class="page-lede" id="plat-lede"></p>
  </section>

  <p class="as-of">
    <span id="as-of">As of --:--</span>
    <span class="stale" id="stale-note" role="status"></span>
  </p>

  <section class="plat-section" aria-labelledby="plat-dep-title">
    <h2 class="plat-title" id="plat-dep-title">Departures</h2>
    <div class="board-cols" aria-hidden="true">
      <span class="col-time">Time</span>
      <span class="col-dest">Destination</span>
      <span class="col-plat">Platform</span>
      <span class="col-status">Status</span>
    </div>
    <ol class="board" id="plat-dep" aria-label="Departures from this platform" data-api={apiBase} data-mock={mock ? 'true' : 'false'}>
      <li class="board-msg">Loading platform…</li>
    </ol>
  </section>

  <section class="plat-section" aria-labelledby="plat-arr-title">
    <h2 class="plat-title" id="plat-arr-title">Arrivals</h2>
    <div class="board-cols" aria-hidden="true">
      <span class="col-time">Time</span>
      <span class="col-dest">From</span>
      <span class="col-plat">Platform</span>
      <span class="col-status">Status</span>
    </div>
    <ol class="board" id="plat-arr" aria-label="Arrivals at this platform">
      <li class="board-msg">Loading platform…</li>
    </ol>
  </section>

  <!-- Visually hidden live region: meaningful changes only (ADR-0002) -->
  <div
    id="announcer"
    class="visually-hidden"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  ></div>

  <script>
    import { initPlatform } from '../../scripts/platform-client';
    const root = document.getElementById('plat-dep');
    if (root instanceof HTMLElement) initPlatform(root);
  </script>
</BaseLayout>
