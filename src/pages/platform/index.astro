---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Per-platform board page. Static SSG shell; the client (platform-client.ts)
// reads ?station=<CRS>&platform=<number> from the URL (so the page is
// shareable and survives "add to home screen"), fetches the station's board
// for the active direction (Departures / Arrivals tabs, like the station
// board) with a one-hour lookback, and lists the services that use this
// platform. Reached by clicking a platform number on the station board or the
// calling-points list.
//
// `||` (not ??) so an empty/unset var falls back to the live Worker.
const apiBase = import.meta.env.PUBLIC_API || 'https://trains-api.upyesp.workers.dev';
const mock = import.meta.env.PUBLIC_MOCK === 'true';
---

<BaseLayout
  title="Platform — VIPTrains.org.uk"
  description="All departures and arrivals from one platform at a UK mainline station."
>
  <p id="plat-back" class="back-wrap"></p>

  <section class="station-head">
    <h1 class="page-title" id="plat-title">Platform</h1>
    <p class="page-lede" id="plat-lede"></p>
  </section>

  <div class="tabs" role="tablist" aria-label="Board type" id="tablist">
    <button
      role="tab"
      id="tab-dep"
      data-kind="departures"
      aria-selected="true"
      aria-controls="plat-board"
      tabindex="0">Departures</button
    >
    <button
      role="tab"
      id="tab-arr"
      data-kind="arrivals"
      aria-selected="false"
      aria-controls="plat-board"
      tabindex="-1">Arrivals</button
    >
  </div>

  <section
    id="plat-board"
    class="board-panel"
    role="tabpanel"
    aria-labelledby="tab-dep"
    tabindex="-1"
    data-api={apiBase}
    data-mock={mock ? 'true' : 'false'}
  >
    <p class="as-of">
      <span id="as-of">As of --:--</span>
      <span class="stale" id="stale-note" role="status"></span>
    </p>
    <div class="board-cols no-plat" aria-hidden="true">
      <span class="col-time">Time</span>
      <span class="col-dest">Destination</span>
      <span class="col-status">Status</span>
    </div>
    <ol
      class="board no-plat"
      id="plat-body"
      aria-label="Services at this platform"
    >
      <li class="board-msg">This board needs JavaScript — enable it to see the platform’s services.</li>
    </ol>
  </section>

  <!-- Visually hidden live region: meaningful changes only (ADR-0002) -->
  <div
    id="announcer"
    class="visually-hidden"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  ></div>

  <script>
    import { initPlatform } from '../../scripts/platform-client';
    const root = document.getElementById('plat-board');
    if (root instanceof HTMLElement) initPlatform(root);
  </script>
</BaseLayout>
