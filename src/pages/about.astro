---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About — VIPTrains.org"
  description="About VIP Trains: a free to use, not-for-profit UK train departure board site optimised for vision impaired people."
>
  <h1 class="page-title">About</h1>

  <div class="about">
    <p>
      A free to use, not-for-profit site with the aim of providing UK train departure board
      information in a format optimised for vision impaired people (VIPs).
    </p>
    <p>
      The site is frequently updated, thanks to feedback received from users.
    </p>
    <p>
      If you find an issue or have suggestions for improving the site please get
      in touch, using the <a href="/contact">contact form</a>.
    </p>
  </div>
</BaseLayout>
