{
  "name": "trains",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro sync && tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:a11y": "node scripts/axe-audit.mjs",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "audit:at": "node scripts/voiceover-audit.mjs",
    "audit:vo": "node scripts/voiceover-audit.mjs --vo",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "audit:matrix": "node scripts/vo-announcement-matrix.mjs",
    "audit:vo-safari": "node scripts/vo-audit-safari.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@guidepup/guidepup": "^0.36.4",
    "astro": "^7.1.4",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "puppeteer": "^25.9.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
